// ~/.config/fastfetch/
 {
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "blue" },
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": " ➜ ",
    "color": "yellow",
    "key": { "width": 10 }
  },
  "modules": [
    {
      "type": "title",
      "color": { "user": "bright_white", "at": "cyan", "host": "bright_cyan" }
    },
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Ker" },
    { "type": "uptime", "key": "Up" },
    { "type": "packages", "key": "Pkgs" },
    { "type": "memory", "key": "Mem" },
    { "type": "battery", "key": "Bat" },
    "break",
  ]
}
